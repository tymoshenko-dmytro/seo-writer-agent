# Copy to .env and fill in. Every key can instead be entered in the setup screen
# (http://localhost:5050/setup) or with `cli.py setup`; a key saved there wins over this file.
# All seven services are required: a run uses every one of them.
# Keep comments on their own lines: a comment after a value becomes part of it.

# ===== The Studio =====

# The team's password for the web interface. Required by docker compose.
UI_PASSWORD=
# Optional: a long random string (32 characters or more) that signs the login cookie. Unset or
# shorter, a random one is kept on the data volume.
UI_SECRET=
# 1 when the Studio is served over https (behind your own proxy).
UI_COOKIE_SECURE=
# The address and the port the server listens on (the image listens on 0.0.0.0).
UI_HOST=127.0.0.1
UI_PORT=5050

# ===== The services (all required) =====

# Anthropic (console.anthropic.com): research planning, the writer, the review, the fixer.
ANTHROPIC_API_KEY=
# OpenAI (platform.openai.com): the GPT read in the review, the cover and illustrations.
OPENAI_API_KEY=
# Parallel (platform.parallel.ai): deep research and the web check of claims.
PARALLEL_API_KEY=
# Ahrefs MCP key (Ahrefs > Account settings > API keys): keywords and search results.
AHREFS_API_KEY=
# Scrapfly (scrapfly.io): screenshots and competitor pages opened from the article's country.
SCRAPFLY_KEY=
# Winston AI (gowinston.ai): the uniqueness check, 2 credits a word.
WINSTON_API_KEY=

# ===== WordPress (required: where the articles are published) =====

# The blog's full https:// address, e.g. https://blog.example.com
WP_BASE_URL=
# A WordPress user who can publish posts (Editor or Administrator).
WP_USERNAME=
# That user's application password (Users > Profile > Application Passwords).
WP_APP_PASSWORD=
# Optional: the user id posts are published as. Unset, the user above.
WP_AUTHOR_ID=

# ===== Folders (defaults shown) =====

# Everything the install saves: the articles, settings, keys. In Docker, the volume.
# CONTENT_OUTPUT_DIR=project/output
# The project's shipped defaults (profile.yaml and its texts).
# CONTENT_PROJECT_DIR=project
# JOBS_FILE=<CONTENT_OUTPUT_DIR>/_jobs.json

# ===== Optional client tuning =====

# ANTHROPIC_TIMEOUT_S=600
# ANTHROPIC_MAX_RETRIES=5
